import asyncio
import requests
import os
import sys

def generate_voiceover(text, output_file="voiceover.mp3"):
    print("[2/5] Synthesizing voiceover...")
    
    elevenlabs_key = os.getenv("ELEVENLABS_API_KEY")
    voice_id = os.getenv("ELEVENLABS_VOICE_ID")
    
    # Attempt 1: Try ElevenLabs
    if elevenlabs_key and voice_id:
        url = f"https://api.elevenlabs.io/v1/text-to-speech/{voice_id}"
        headers = {
            "Accept": "audio/mpeg",
            "Content-Type": "application/json",
            "xi-api-key": elevenlabs_key
        }
        data = {
            "text": text,
            "model_id": "eleven_monolingual_v1",
            "voice_settings": {"stability": 0.5, "similarity_boost": 0.75}
        }
        
        response = requests.post(url, json=data, headers=headers)
        
        if response.status_code == 200:
            with open(output_file, "wb") as f:
                f.write(response.content)
            print("Success! Voiceover generated with ElevenLabs.")
            return
        else:
            print(f"ElevenLabs hit limit/error ({response.status_code}). Switching to Edge-TTS Neural fallback...")

    # Attempt 2: Fallback to Edge-TTS (en-US-ChristopherNeural)
    async def run_edge_tts():
        import edge_tts
        # Options: "en-US-ChristopherNeural", "en-US-GuyNeural", "en-US-AvaNeural"
        voice = "en-US-ChristopherNeural" 
        communicate = edge_tts.Communicate(text, voice)
        await communicate.save(output_file)

    try:
        asyncio.run(run_edge_tts())
        print("Success! Voiceover generated with Edge-TTS Neural voice (en-US-ChristopherNeural).")
    except Exception as e:
        print(f"Error generating voiceover with Edge-TTS: {e}")
        sys.exit(1)
