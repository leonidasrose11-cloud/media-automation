# [1/5] GEMINI SCRIPT & METADATA GENERATION (SEPARATE LONG-FORM & SHORT SCRIPTS)
def generate_script_from_gemini():
    print("[1/5] Querying Gemini API for masterclass and standalone Short scripts...")
    
    chosen_topic = random.choice(FINANCE_TOPICS)
    
    SYSTEM_INSTRUCTION = """
You are a brilliant, slightly cynical, and highly sarcastic Gen Z financial analyst. 
You write massive, highly detailed 11-minute YouTube masterclass scripts AND completely separate, viral 45-second YouTube Short scripts.

The Short script must be related to the same topic as the long-form video, but it must be a standalone piece with its own punchy hook, valuable insight, and call to action to watch the full long-form video.

Return ONLY a raw JSON object with this exact structure:
{
  "longform_title": "Punchy long-form title (under 60 chars)",
  "longform_description": "2-3 sentence engaging description with #finance #wealth hashtags",
  "longform_script": "Full continuous spoken script (1600-1800 words). Do not include section labels, just spoken text.",
  "short_title": "Viral Shorts title ending in #shorts #finance",
  "short_description": "Quick short description #shorts #wealth",
  "short_script": "Standalone 45-second short script (approx 90-110 words) with its own hook and CTA.",
  "thumbnail_concept": "High CTR thumbnail text + visual concept description"
}
"""

    model = genai.GenerativeModel(
        model_name='gemini-2.5-flash',
        system_instruction=SYSTEM_INSTRUCTION
    )
    
    prompt = f"Write an extensive 11-minute masterclass script plus a standalone Short script about: '{chosen_topic}'"

    try:
        response = model.generate_content(
            prompt,
            generation_config={
                "response_mime_type": "application/json",
                "max_output_tokens": 8192,
                "temperature": 0.7
            }
        )
        data = json.loads(response.text)
        script_text = data["longform_script"]
        short_script_text = data.get("short_script", "")
        word_count = len(script_text.split())
        
        with open("video_metadata.json", "w", encoding="utf-8") as f:
            json.dump(data, f)
            
        with open("script.txt", "w", encoding="utf-8") as f:
            f.write(script_text)
            
        with open("short_script.txt", "w", encoding="utf-8") as f:
            f.write(short_script_text)
            
        print(f"Success! Topic selected: '{chosen_topic}'")
        print(f"Long-form Word Count: {word_count} words (~{word_count / 150:.1f} mins)")
        print(f"Short Script Word Count: {len(short_script_text.split())} words")
        return script_text
    except Exception as e:
        print(f"Error generating script from Gemini: {e}")
        sys.exit(1)

# [2/5] VOICEOVER GENERATION (LONG-FORM & SHORT)
def generate_voiceovers(output_path="voiceover.mp3", short_output_path="voiceover_short.mp3"):
    print("[2/5] Synthesizing voiceovers (Long-form & Short)...")
    
    if not os.path.exists("script.txt") or not os.path.exists("short_script.txt"):
        print("Error: Script files missing!")
        sys.exit(1)
        
    with open("script.txt", "r", encoding="utf-8") as f:
        long_text = f.read()
        
    with open("short_script.txt", "r", encoding="utf-8") as f:
        short_text = f.read()

    async def run_edge_tts():
        import edge_tts
        # Longform voiceover
        comm_long = edge_tts.Communicate(long_text, "en-US-ChristopherNeural")
        await comm_long.save(output_path)
        # Short voiceover
        comm_short = edge_tts.Communicate(short_text, "en-US-ChristopherNeural")
        await comm_short.save(short_output_path)

    try:
        asyncio.run(run_edge_tts())
        print("Success! Both voiceovers generated with Edge-TTS.")
    except Exception as e:
        print(f"Error generating voiceovers: {e}")
        sys.exit(1)

# [3/5] PEXELS STOCK FOOTAGE DOWNLOADER (DOWNLOADS 25 CLIPS)
def fetch_luxury_stock_footage(num_clips=25):
    query = random.choice(PEXELS_QUERIES)
    random_page = random.randint(1, 5)
    print(f"[3/5] Fetching {num_clips} stock clips for '{query}' (Page {random_page}) from Pexels API...")
    
    pexels_api_key = os.environ.get("PEXELS_API_KEY")
    if not pexels_api_key:
        print("Error: PEXELS_API_KEY is missing!")
        sys.exit(1)

    os.makedirs("raw_clips", exist_ok=True)
    headers = {"Authorization": pexels_api_key}
    url = f"https://api.pexels.com/videos/search?query={query}&per_page={num_clips}&page={random_page}&orientation=landscape"

    try:
        response = requests.get(url, headers=headers, timeout=30)
        if response.status_code != 200:
            print(f"Pexels API Error: {response.status_code}")
            sys.exit(1)

        videos = response.json().get("videos", [])
        if not videos:
            print("No videos found on Pexels for query, falling back to default page...")
            url = f"https://api.pexels.com/videos/search?query={query}&per_page={num_clips}&orientation=landscape"
            videos = requests.get(url, headers=headers, timeout=30).json().get("videos", [])

        downloaded_count = 0
        for i, video in enumerate(videos):
            video_files = video.get("video_files", [])
            hd_files = [f for f in video_files if f.get("file_type") == "video/mp4" and f.get("width", 0) >= 1280]
            target_file = hd_files[0] if hd_files else (video_files[0] if video_files else None)
            
            if target_file:
                download_url = target_file.get("link")
                file_path = f"raw_clips/clip_{i+1}.mp4"
                print(f"Downloading clip {i+1}/{len(videos)}...")
                clip_data = requests.get(download_url, timeout=30).content
                with open(file_path, "wb") as f:
                    f.write(clip_data)
                downloaded_count += 1

        print(f"Success! Downloaded {downloaded_count} stock clips.")
    except Exception as e:
        print(f"Failed to download Pexels footage: {e}")
        sys.exit(1)

# [4/5] MOVIEPY DYNAMIC RENDER ENGINE (SEPARATE LONG-FORM & STANDALONE SHORT)
def render_luxury_videos():
    print("[4/5] Initiating MoviePy Editor for Long-form and Standalone Short...")
    
    if not os.path.exists("voiceover.mp3") or not os.path.exists("voiceover_short.mp3"):
        print("Error: Voiceover files missing.")
        sys.exit(1)

    voiceover = AudioFileClip("voiceover.mp3")
    total_duration = voiceover.duration
    print(f"Long-form audio duration: {total_duration / 60:.2f} minutes")

    clip_files = [f"raw_clips/{f}" for f in os.listdir("raw_clips") if f.endswith(".mp4")]
    if not clip_files:
        print("Error: No clips found in 'raw_clips/'.")
        sys.exit(1)
        
    loaded_videos = []
    for file in clip_files:
        try:
            loaded_videos.append(VideoFileClip(file))
        except Exception as e:
            print(f"Skipping clip {file}: {e}")

    # --- RENDER LONG-FORM VIDEO ---
    processed_subclips = []
    current_time = 0
    while current_time < total_duration:
        random.shuffle(loaded_videos)
        for video in loaded_videos:
            if current_time >= total_duration:
                break
            try:
                start_sec = random.uniform(0, max(0.1, video.duration - 2.5)) if video.duration > 2.5 else 0
                subclip = video.subclip(start_sec, start_sec + 2.0).resize(newsize=(1920, 1080))
                subclip = subclip.fx(vfx.colorx, 0.7)  
                processed_subclips.append(subclip)
                current_time += 2.0
            except Exception as e:
                continue

    background_video = concatenate_videoclips(processed_subclips, method="compose").subclip(0, total_duration)

    with open("script.txt", "r", encoding="utf-8") as f:
        script_text = f.read()

    words = script_text.split()
    total_words = len(words)
    time_per_word = total_duration / max(1, total_words)
    
    chunk_size = 3
    longform_subtitle_clips = [background_video]
    sub_time = 0.0
    
    for i in range(0, total_words, chunk_size):
        chunk = words[i:i+chunk_size]
        subtitle_text = " ".join(chunk).upper()
        chunk_duration = len(chunk) * time_per_word
        
        try:
            txt_clip = (TextClip(subtitle_text, 
                                 fontsize=55, 
                                 font='DejaVu-Sans-Bold',
                                 color='white', 
                                 stroke_color='black', 
                                 stroke_width=2,
                                 method='caption',
                                 size=(1720, None))
                        .set_start(sub_time)
                        .set_duration(chunk_duration)
                        .set_position(('center', 'center')))
            longform_subtitle_clips.append(txt_clip)
        except Exception as e:
            pass
            
        sub_time += chunk_duration

    final_comp = CompositeVideoClip(longform_subtitle_clips).set_audio(voiceover).set_duration(total_duration)
    print("Encoding final long-form video...")
    final_comp.write_videofile("final_longform.mp4", fps=30, codec="libx264", preset="ultrafast")

    # --- RENDER STANDALONE SHORT ---
    print("Rendering standalone vertical Short...")
    short_voiceover = AudioFileClip("voiceover_short.mp3")
    short_duration = short_voiceover.duration

    short_subclips = []
    short_time = 0
    while short_time < short_duration:
        random.shuffle(loaded_videos)
        for video in loaded_videos:
            if short_time >= short_duration:
                break
            try:
                start_sec = random.uniform(0, max(0.1, video.duration - 2.0))
                sub = video.subclip(start_sec, start_sec + 2.0).crop(x_center=video.w/2, y_center=video.h/2, width=video.h*9/16, height=video.h).resize(newsize=(720, 1280))
                sub = sub.fx(vfx.colorx, 0.7)
                short_subclips.append(sub)
                short_time += 2.0
            except Exception as e:
                continue
                
    raw_short_bg = concatenate_videoclips(short_subclips, method="compose").subclip(0, short_duration)

    with open("short_script.txt", "r", encoding="utf-8") as f:
        short_script_text = f.read()

    s_words = short_script_text.split()
    s_time_per_word = short_duration / max(1, len(s_words))
    
    short_subtitle_clips = [raw_short_bg]
    sub_t = 0.0
    for i in range(0, len(s_words), 3):
        chunk = s_words[i:i+3]
        txt = " ".join(chunk).upper()
        dur = len(chunk) * s_time_per_word
        try:
            txt_clip = (TextClip(txt, fontsize=42, font='DejaVu-Sans-Bold', color='yellow', stroke_color='black', stroke_width=3, method='caption', size=(600, None))
                        .set_start(sub_t)
                        .set_duration(dur)
                        .set_position(('center', 'center')))
            short_subtitle_clips.append(txt_clip)
        except Exception as e:
            pass
        sub_t += dur
        
    final_short_comp = CompositeVideoClip(short_subtitle_clips).set_audio(short_voiceover).set_duration(short_duration)
    final_short_comp.write_videofile("final_short.mp4", fps=30, codec="libx264", preset="ultrafast")

    for v in loaded_videos:
        v.close()
    voiceover.close()
    short_voiceover.close()
    print("Success! Long-form and standalone Short compiled completely.")

# [5/5] YOUTUBE UPLOADER ENGINE
def upload_to_youtube():
    print("[5/5] Authorizing and uploading to YouTube...")
    from googleapiclient.discovery import build
    from googleapiclient.http import MediaFileUpload
    from google.oauth2.credentials import Credentials
    
    refresh_token = os.environ.get("YOUTUBE_REFRESH_TOKEN")
    client_id = os.environ.get("YOUTUBE_CLIENT_ID")
    client_secret = os.environ.get("YOUTUBE_CLIENT_SECRET")
    
    if not all([refresh_token, client_id, client_secret]):
        print("YouTube API secrets missing. Skipping upload step.")
        return

    if os.path.exists("video_metadata.json"):
        with open("video_metadata.json", "r", encoding="utf-8") as f:
            meta = json.load(f)
        long_title = meta.get("longform_title", "Unlocking Generational Wealth")
        long_desc = meta.get("longform_description", "Welcome to Apex Wealth Lab. #finance #wealth")
        short_title = meta.get("short_title", "How the 1% grow wealth #shorts #finance")
        short_desc = meta.get("short_description", "Hidden money secrets #shorts")
    else:
        long_title = "The Hidden Systems Behind Global Markets"
        long_desc = "Masterclass on finance and wealth creation."
        short_title = "Wealth mindset #shorts"
        short_desc = "Finance tips #shorts"

    creds = Credentials(
        token=None,
        refresh_token=refresh_token,
        token_uri="https://oauth2.googleapis.com/token",
        client_id=client_id,
        client_secret=client_secret
    )
    
    try:
        youtube = build("youtube", "v3", credentials=creds)
        
        if os.path.exists("final_longform.mp4"):
            print(f"Uploading long-form video: '{long_title}'...")
            longform_body = {
                "snippet": {
                    "title": long_title,
                    "description": long_desc,
                    "categoryId": "27"
                },
                "status": {
                    "privacyStatus": "public",
                    "selfDeclaredMadeForKids": False
                }
            }
            media_long = MediaFileUpload("final_longform.mp4", chunksize=-1, resumable=True)
            request_long = youtube.videos().insert(part="snippet,status", body=longform_body, media_body=media_long)
            response_long = request_long.execute()
            print(f"Success! Long-form uploaded. ID: {response_long.get('id')}")
            
        if os.path.exists("final_short.mp4"):
            print(f"Uploading Short video: '{short_title}'...")
            short_body = {
                "snippet": {
                    "title": short_title,
                    "description": short_desc,
                    "categoryId": "27"
                },
                "status": {
                    "privacyStatus": "public",
                    "selfDeclaredMadeForKids": False
                }
            }
            media_short = MediaFileUpload("final_short.mp4", chunksize=-1, resumable=True)
            request_short = youtube.videos().insert(part="snippet,status", body=short_body, media_body=media_short)
            response_short = request_short.execute()
            print(f"Success! Short uploaded. ID: {response_short.get('id')}")
            
    except Exception as e:
        print(f"An error occurred during YouTube upload: {e}")
        sys.exit(1)

